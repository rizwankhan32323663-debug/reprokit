# Local development environment (copy to .dev.vars — NEVER commit it)
# Production values live in the Cloudflare dashboard secret storage.

# Long random secret for better-auth session/token signing.
# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-local-dev-only

# Local dev server URL (overridden in production by the dashboard).
BETTER_AUTH_URL=http://localhost:8788
